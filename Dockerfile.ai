FROM python:3.12-slim

WORKDIR /app

COPY requirements-ai.txt .

RUN pip install \
    --no-cache-dir \
    torch torchvision \
    --index-url \
    https://download.pytorch.org/whl/cpu

RUN pip install \
    --no-cache-dir \
    -r requirements-ai.txt

COPY ai ./ai

CMD ["uvicorn", "ai.main:app", "--host", "0.0.0.0", "--port", "8001"]